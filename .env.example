# Copiar como ".env" en la raíz del repo y completar con datos reales.
# Los lee backend/Config/project_config.py vía os.getenv().

DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=agroclima

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# Nunca reutilizar un valor de ejemplo ni commitear el real.
JWT_SECRET_KEY=changeme

# Orígenes del frontend separados por comas, ej: http://localhost:5173,https://miapp.com
# Vacío = ningún origen permitido (nunca usar "*" aquí).
CORS_ORIGINS=
